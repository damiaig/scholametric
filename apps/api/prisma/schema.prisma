datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [citext, pg_trgm]
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

enum SchoolType {
  NURSERY_PRIMARY
  SECONDARY
  COMBINED
}

enum SchoolStatus {
  ACTIVE
  SUSPENDED
}

enum UserRole {
  SUPER_ADMIN
  PROPRIETOR
  SCHOOL_ADMIN
  TEACHER
  PARENT
  STUDENT
}

enum JobTitle {
  DIRECTOR_PROPRIETOR
  PRINCIPAL
  VICE_PRINCIPAL
  REGISTRAR
  EXAMINATION_OFFICER
  BURSAR
  SECRETARY
  ICT_ADMINISTRATOR
  SCHOOL_NURSE
  GUIDANCE_COUNSELOR
  TEACHER
  OTHER
}

enum GuardianRelationship {
  FATHER
  MOTHER
  STEPFATHER
  STEPMOTHER
  GRANDPARENT
  UNCLE
  AUNT
  SIBLING
  LEGAL_GUARDIAN
  OTHER
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum TermName {
  FIRST
  SECOND
  THIRD
}

enum Gender {
  MALE
  FEMALE
}

enum StudentStatus {
  ACTIVE
  SUSPENDED
  GRADUATED
  TRANSFERRED
  WITHDRAWN
}

model School {
  id        String       @id @default(uuid(7)) @db.Uuid
  name      String
  slug      String       @unique
  type      SchoolType
  address   String?
  phone     String?
  email     String?
  status    SchoolStatus @default(ACTIVE)
  createdAt DateTime     @default(now()) @map("created_at")
  updatedAt DateTime     @updatedAt @map("updated_at")

  users                     User[]
  academicSessions          AcademicSession[]
  terms                     Term[]
  classLevels               ClassLevel[]
  classArms                 ClassArm[]
  students                  Student[]
  studentEnrollments        StudentEnrollment[]
  auditLogs                 AuditLog[]
  staffProfiles             StaffProfile[]
  subjects                  Subject[]
  subjectClassLevels        SubjectClassLevel[]
  classTeacherAssignments   ClassTeacherAssignment[]
  subjectTeacherAssignments SubjectTeacherAssignment[]
  guardians                 Guardian[]
  studentGuardians          StudentGuardian[]
  gradeBoundaries           GradeBoundary[]
  termSubjectResults        TermSubjectResult[]
  termOverallResults        TermOverallResult[]
  termUnlocks               TermUnlock[]
  termRemarks               TermRemark[]
  evaluations               Evaluation[]
  exams                     Exam[]
  termSubjectExamResults    TermSubjectExamResult[]
  termExamResults           TermExamResult[]
  yearExamResults           YearExamResult[]

  @@map("schools")
}

model User {
  id                 String     @id @default(uuid(7)) @db.Uuid
  schoolId           String     @map("school_id") @db.Uuid
  // Nullable as of v0.6 (SPEC_V0.6.md §4): staff still log in by email
  // (required in practice, enforced at the API layer for STAFF-ish roles);
  // STUDENT/PARENT portal accounts log in by username instead (below) and
  // carry no email. @@unique tolerates multiple NULLs per Postgres — every
  // staff row keeps its own uniqueness untouched.
  email              String?    @db.Citext
  // Portal-account login handle (v0.6). NULL for every staff role. Always
  // CAPS by construction (portal-accounts.service.ts) but Citext for a
  // case-insensitive uniqueness/login safety net regardless.
  username           String?    @db.Citext
  passwordHash       String     @map("password_hash")
  firstName          String     @map("first_name")
  lastName           String     @map("last_name")
  role               UserRole
  status             UserStatus @default(ACTIVE)
  lastLoginAt        DateTime?  @map("last_login_at")
  // Set true by personnel creation and password reset; cleared by a
  // successful POST /auth/change-password (SPEC_V0.3.md §1/§2). Also set
  // true by portal-account provisioning (v0.6) — same flow, no fork.
  mustChangePassword Boolean    @default(false) @map("must_change_password")
  // v0.6 (SPEC_V0.6.md §4): exactly one of these two is set for a
  // STUDENT/PARENT account, and neither is set for staff — enforced again
  // at the DB layer by a hand-added CHECK constraint (see migration), not
  // just here.
  studentId          String?    @unique @map("student_id") @db.Uuid
  guardianId         String?    @unique @map("guardian_id") @db.Uuid
  deletedAt          DateTime?  @map("deleted_at")
  createdAt          DateTime   @default(now()) @map("created_at")
  updatedAt          DateTime   @updatedAt @map("updated_at")

  school                    School                     @relation(fields: [schoolId], references: [id])
  student                   Student?                   @relation(fields: [studentId], references: [id])
  guardian                  Guardian?                  @relation(fields: [guardianId], references: [id])
  refreshTokens             RefreshToken[]
  auditLogs                 AuditLog[]
  staffProfile              StaffProfile?
  classTeacherAssignments   ClassTeacherAssignment[]
  subjectTeacherAssignments SubjectTeacherAssignment[]
  termsClosed               Term[]                     @relation("TermClosedBy")
  termUnlocksUnlocked       TermUnlock[]               @relation("TermUnlockUnlockedBy")
  termUnlocksRelocked       TermUnlock[]               @relation("TermUnlockRelockedBy")
  termRemarksAsTeacher      TermRemark[]               @relation("TermRemarkTeacherBy")
  termRemarksAsPrincipal    TermRemark[]               @relation("TermRemarkPrincipalBy")
  evaluationsCreated        Evaluation[]               @relation("EvaluationCreatedBy")
  evaluationScoresEntered   EvaluationScore[]          @relation("EvaluationScoreEnteredBy")
  examsCreated              Exam[]                     @relation("ExamCreatedBy")
  examScoresEntered         ExamScore[]                @relation("ExamScoreEnteredBy")

  @@unique([schoolId, email])
  @@unique([schoolId, username])
  @@index([schoolId])
  @@map("users")
}

// No school_id here by design — a refresh token is only ever reached via
// user_id, and the owning user already carries school_id. See
// docs/DECISIONS.md for the tradeoff against CLAUDE.md §4's general rule.
model RefreshToken {
  id        String    @id @default(uuid(7)) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  revokedAt DateTime? @map("revoked_at")
  createdAt DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("refresh_tokens")
}

// Exactly one is_current = true per school is enforced by a partial
// unique index added by hand in the initial migration — Prisma's schema
// DSL can't express partial indexes. See docs/DECISIONS.md.
model AcademicSession {
  id        String   @id @default(uuid(7)) @db.Uuid
  schoolId  String   @map("school_id") @db.Uuid
  name      String
  startsOn  DateTime @map("starts_on") @db.Date
  endsOn    DateTime @map("ends_on") @db.Date
  isCurrent Boolean  @default(false) @map("is_current")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  school                    School                     @relation(fields: [schoolId], references: [id])
  terms                     Term[]
  studentEnrollments        StudentEnrollment[]
  classTeacherAssignments   ClassTeacherAssignment[]
  subjectTeacherAssignments SubjectTeacherAssignment[]
  termSubjectResults        TermSubjectResult[]
  termOverallResults        TermOverallResult[]
  termRemarks               TermRemark[]
  evaluations               Evaluation[]
  exams                     Exam[]
  termSubjectExamResults    TermSubjectExamResult[]
  termExamResults           TermExamResult[]
  yearExamResults           YearExamResult[]

  @@unique([schoolId, name])
  @@index([schoolId])
  @@map("academic_sessions")
}

// Exactly one is_current = true per session is enforced by a partial
// unique index added by hand in the initial migration, same as above.
model Term {
  id        String    @id @default(uuid(7)) @db.Uuid
  schoolId  String    @map("school_id") @db.Uuid
  sessionId String    @map("session_id") @db.Uuid
  name      TermName
  startsOn  DateTime  @map("starts_on") @db.Date
  endsOn    DateTime  @map("ends_on") @db.Date
  isCurrent Boolean   @default(false) @map("is_current")
  // SPEC_V0.5.md §2.3 — null = open (v0.4's implicit state, unchanged for
  // every existing term). Set by a deliberate principal/proprietor close
  // action (v0.5 step 3); there is no "reopen the whole term" concept —
  // editing a closed term happens per class-arm+subject via term_unlocks
  // below, not by flipping this back to null.
  closedAt  DateTime? @map("closed_at")
  closedBy  String?   @map("closed_by") @db.Uuid
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  school                 School                  @relation(fields: [schoolId], references: [id])
  session                AcademicSession         @relation(fields: [sessionId], references: [id])
  closedByUser           User?                   @relation("TermClosedBy", fields: [closedBy], references: [id])
  termSubjectResults     TermSubjectResult[]
  termOverallResults     TermOverallResult[]
  termUnlocks            TermUnlock[]
  termRemarks            TermRemark[]
  evaluations            Evaluation[]
  exams                  Exam[]
  termSubjectExamResults TermSubjectExamResult[]
  termExamResults        TermExamResult[]

  @@unique([sessionId, name])
  @@index([schoolId])
  @@map("terms")
}

model ClassLevel {
  id        String   @id @default(uuid(7)) @db.Uuid
  schoolId  String   @map("school_id") @db.Uuid
  name      String
  rank      Int
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  school             School              @relation(fields: [schoolId], references: [id])
  classArms          ClassArm[]
  subjectClassLevels SubjectClassLevel[]

  @@unique([schoolId, name])
  @@index([schoolId])
  @@map("class_levels")
}

model ClassArm {
  id           String   @id @default(uuid(7)) @db.Uuid
  schoolId     String   @map("school_id") @db.Uuid
  classLevelId String   @map("class_level_id") @db.Uuid
  name         String
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  school                    School                     @relation(fields: [schoolId], references: [id])
  classLevel                ClassLevel                 @relation(fields: [classLevelId], references: [id])
  studentEnrollments        StudentEnrollment[]
  classTeacherAssignments   ClassTeacherAssignment[]
  subjectTeacherAssignments SubjectTeacherAssignment[]
  termSubjectResults        TermSubjectResult[]
  termOverallResults        TermOverallResult[]
  termUnlocks               TermUnlock[]
  termRemarks               TermRemark[]
  evaluations               Evaluation[]
  exams                     Exam[]
  termSubjectExamResults    TermSubjectExamResult[]
  termExamResults           TermExamResult[]

  @@unique([classLevelId, name])
  @@index([schoolId])
  @@map("class_arms")
}

// Trigram index on (first_name, last_name) for ILIKE search added by
// hand in the initial migration — Prisma's index DSL has no way to
// specify the gin_trgm_ops operator class. See docs/DECISIONS.md.
model Student {
  id              String        @id @default(uuid(7)) @db.Uuid
  schoolId        String        @map("school_id") @db.Uuid
  admissionNumber String        @map("admission_number")
  firstName       String        @map("first_name")
  lastName        String        @map("last_name")
  middleName      String?       @map("middle_name")
  gender          Gender
  dateOfBirth     DateTime      @map("date_of_birth") @db.Date
  admittedOn      DateTime      @default(now()) @map("admitted_on") @db.Date
  status          StudentStatus @default(ACTIVE)
  // Frozen as of v0.2 (SPEC_V0.2.md §1): backfilled into guardians/
  // student_guardians by the v0.2 migration, but no longer written by new
  // code. Kept for now — dropping is a future migration once the new
  // tables are verified in production use.
  guardianName    String        @map("guardian_name")
  guardianPhone   String        @map("guardian_phone")
  guardianEmail   String?       @map("guardian_email")
  address         String?
  deletedAt       DateTime?     @map("deleted_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  school                 School                  @relation(fields: [schoolId], references: [id])
  enrollments            StudentEnrollment[]
  studentGuardians       StudentGuardian[]
  termSubjectResults     TermSubjectResult[]
  termOverallResults     TermOverallResult[]
  termRemarks            TermRemark[]
  // v0.6: the one portal STUDENT account for this student, if provisioned.
  portalAccount          User?
  evaluationScores       EvaluationScore[]
  examScores             ExamScore[]
  termSubjectExamResults TermSubjectExamResult[]
  termExamResults        TermExamResult[]
  yearExamResults        YearExamResult[]

  @@unique([schoolId, admissionNumber])
  @@index([schoolId])
  @@map("students")
}

model StudentEnrollment {
  id         String   @id @default(uuid(7)) @db.Uuid
  schoolId   String   @map("school_id") @db.Uuid
  studentId  String   @map("student_id") @db.Uuid
  classArmId String   @map("class_arm_id") @db.Uuid
  sessionId  String   @map("session_id") @db.Uuid
  enrolledOn DateTime @default(now()) @map("enrolled_on") @db.Date
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  school   School          @relation(fields: [schoolId], references: [id])
  student  Student         @relation(fields: [studentId], references: [id])
  classArm ClassArm        @relation(fields: [classArmId], references: [id])
  session  AcademicSession @relation(fields: [sessionId], references: [id])

  @@unique([studentId, sessionId])
  @@index([schoolId, classArmId, sessionId])
  @@index([studentId])
  @@map("student_enrollments")
}

model AuditLog {
  id          String   @id @default(uuid(7)) @db.Uuid
  schoolId    String   @map("school_id") @db.Uuid
  actorUserId String   @map("actor_user_id") @db.Uuid
  action      String
  entityType  String   @map("entity_type")
  entityId    String   @map("entity_id") @db.Uuid
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")

  school School @relation(fields: [schoolId], references: [id])
  actor  User   @relation(fields: [actorUserId], references: [id])

  @@index([schoolId])
  @@map("audit_logs")
}

// 1:1 extension of User for every PROPRIETOR/SCHOOL_ADMIN/TEACHER
// (enforced at the service layer, not the DB — v0.2 step 2).
model StaffProfile {
  id            String    @id @default(uuid(7)) @db.Uuid
  schoolId      String    @map("school_id") @db.Uuid
  userId        String    @unique @map("user_id") @db.Uuid
  staffNumber   String    @map("staff_number")
  jobTitle      JobTitle  @map("job_title")
  phone         String?
  qualification String?
  dateEmployed  DateTime? @map("date_employed") @db.Date
  deletedAt     DateTime? @map("deleted_at")
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  school School @relation(fields: [schoolId], references: [id])
  user   User   @relation(fields: [userId], references: [id])

  @@unique([schoolId, staffNumber])
  @@index([schoolId])
  @@map("staff_profiles")
}

model Subject {
  id        String    @id @default(uuid(7)) @db.Uuid
  schoolId  String    @map("school_id") @db.Uuid
  name      String
  code      String?
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  school                 School                     @relation(fields: [schoolId], references: [id])
  classLevels            SubjectClassLevel[]
  teacherAssignments     SubjectTeacherAssignment[]
  termSubjectResults     TermSubjectResult[]
  termUnlocks            TermUnlock[]
  evaluations            Evaluation[]
  exams                  Exam[]
  termSubjectExamResults TermSubjectExamResult[]

  @@unique([schoolId, name])
  @@index([schoolId])
  @@map("subjects")
}

model SubjectClassLevel {
  id           String   @id @default(uuid(7)) @db.Uuid
  schoolId     String   @map("school_id") @db.Uuid
  subjectId    String   @map("subject_id") @db.Uuid
  classLevelId String   @map("class_level_id") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  school     School     @relation(fields: [schoolId], references: [id])
  subject    Subject    @relation(fields: [subjectId], references: [id])
  classLevel ClassLevel @relation(fields: [classLevelId], references: [id])

  @@unique([subjectId, classLevelId])
  @@index([schoolId])
  @@map("subject_class_levels")
}

model ClassTeacherAssignment {
  id            String   @id @default(uuid(7)) @db.Uuid
  schoolId      String   @map("school_id") @db.Uuid
  classArmId    String   @map("class_arm_id") @db.Uuid
  sessionId     String   @map("session_id") @db.Uuid
  teacherUserId String   @map("teacher_user_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  school      School          @relation(fields: [schoolId], references: [id])
  classArm    ClassArm        @relation(fields: [classArmId], references: [id])
  session     AcademicSession @relation(fields: [sessionId], references: [id])
  teacherUser User            @relation(fields: [teacherUserId], references: [id])

  @@unique([classArmId, sessionId])
  @@index([schoolId])
  @@map("class_teacher_assignments")
}

model SubjectTeacherAssignment {
  id            String   @id @default(uuid(7)) @db.Uuid
  schoolId      String   @map("school_id") @db.Uuid
  subjectId     String   @map("subject_id") @db.Uuid
  classArmId    String   @map("class_arm_id") @db.Uuid
  sessionId     String   @map("session_id") @db.Uuid
  teacherUserId String   @map("teacher_user_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  school      School          @relation(fields: [schoolId], references: [id])
  subject     Subject         @relation(fields: [subjectId], references: [id])
  classArm    ClassArm        @relation(fields: [classArmId], references: [id])
  session     AcademicSession @relation(fields: [sessionId], references: [id])
  teacherUser User            @relation(fields: [teacherUserId], references: [id])

  @@unique([subjectId, classArmId, sessionId])
  @@index([schoolId, teacherUserId, sessionId])
  @@map("subject_teacher_assignments")
}

model Guardian {
  id        String    @id @default(uuid(7)) @db.Uuid
  schoolId  String    @map("school_id") @db.Uuid
  firstName String    @map("first_name")
  lastName  String    @map("last_name")
  phone     String
  email     String?
  address   String?
  deletedAt DateTime? @map("deleted_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  school           School            @relation(fields: [schoolId], references: [id])
  studentGuardians StudentGuardian[]
  // v0.6: the one portal PARENT account for this guardian, if they're an
  // anchor guardian and provisioning has run. Non-anchor guardians (e.g. a
  // second, non-primary parent) never get one in v0.6 (SPEC_V0.6.md §2.2c).
  portalAccount    User?

  @@index([schoolId])
  @@map("guardians")
}

// Exactly one is_primary = true per student is enforced by a partial
// unique index added by hand in this migration — same pattern as v0.1's
// academic_sessions/terms current-flag indexes. See docs/DECISIONS.md.
model StudentGuardian {
  id           String               @id @default(uuid(7)) @db.Uuid
  schoolId     String               @map("school_id") @db.Uuid
  studentId    String               @map("student_id") @db.Uuid
  guardianId   String               @map("guardian_id") @db.Uuid
  relationship GuardianRelationship
  isPrimary    Boolean              @default(false) @map("is_primary")
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")

  school   School   @relation(fields: [schoolId], references: [id])
  student  Student  @relation(fields: [studentId], references: [id])
  guardian Guardian @relation(fields: [guardianId], references: [id])

  @@unique([studentId, guardianId])
  @@index([schoolId])
  @@map("student_guardians")
}

// v0.7 step 1 (SPEC_V0.7.md §2/§3) — REPLACES the fixed CA1/CA2/Exam
// assessment-component model entirely (schema cutover — no pilot-school
// data to preserve, see docs/DECISIONS.md). A teacher-created evaluation
// belongs to exactly one (class arm, subject, term) — unlike the old
// StudentScore, which had to denormalize class_arm_id onto every score
// row because a component alone couldn't scope one, EvaluationScore below
// only needs (evaluationId, studentId): the evaluation itself already
// carries the full scope, so nothing about it is re-derived per score.
// Publishing is unchanged from v0.4/v0.5 (see term_subject_results below)
// — this table has no publish state of its own. name/description freely
// editable while the subject/term is unpublished; the evaluation SET is
// frozen once published (adding a new one requires unpublish-first, the
// existing path) — enforced by Step 2's authoring endpoints, not here.
model Evaluation {
  id          String    @id @default(uuid(7)) @db.Uuid
  schoolId    String    @map("school_id") @db.Uuid
  classArmId  String    @map("class_arm_id") @db.Uuid
  subjectId   String    @map("subject_id") @db.Uuid
  sessionId   String    @map("session_id") @db.Uuid
  termId      String    @map("term_id") @db.Uuid
  name        String
  description String
  createdBy   String    @map("created_by") @db.Uuid
  deletedAt   DateTime? @map("deleted_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  school        School            @relation(fields: [schoolId], references: [id])
  classArm      ClassArm          @relation(fields: [classArmId], references: [id])
  subject       Subject           @relation(fields: [subjectId], references: [id])
  session       AcademicSession   @relation(fields: [sessionId], references: [id])
  term          Term              @relation(fields: [termId], references: [id])
  createdByUser User              @relation("EvaluationCreatedBy", fields: [createdBy], references: [id])
  scores        EvaluationScore[]

  @@index([schoolId, classArmId, subjectId, termId])
  @@map("evaluations")
}

// rawScore/isAbsent mutually exclusive — same hand-added CHECK constraint
// shape student_scores had (see migration SQL). No schoolId here — same
// reasoning as RefreshToken not carrying one (docs/DECISIONS.md): a score
// is only ever reached via its already-tenant-verified evaluationId.
model EvaluationScore {
  id           String    @id @default(uuid(7)) @db.Uuid
  evaluationId String    @map("evaluation_id") @db.Uuid
  studentId    String    @map("student_id") @db.Uuid
  rawScore     Decimal?  @map("raw_score") @db.Decimal(5, 2)
  isAbsent     Boolean   @default(false) @map("is_absent")
  enteredBy    String?   @map("entered_by") @db.Uuid
  enteredAt    DateTime? @map("entered_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  evaluation    Evaluation @relation(fields: [evaluationId], references: [id])
  student       Student    @relation(fields: [studentId], references: [id])
  enteredByUser User?      @relation("EvaluationScoreEnteredBy", fields: [enteredBy], references: [id])

  @@unique([evaluationId, studentId])
  @@map("evaluation_scores")
}

// Track B (SPEC_V0.7.md §2) — exams never contribute to term_subject_
// results/term_overall_results; they compute into their own parallel
// cache tables below (term_subject_exam_results/term_exam_results/
// year_exam_results). Structurally identical to Evaluation/
// EvaluationScore; kept as a separate model rather than a `track` column
// because the two tracks have different aggregate tables and different
// publish actions — one shared table would just move the fork into every
// query's WHERE clause instead of the table name.
model Exam {
  id         String    @id @default(uuid(7)) @db.Uuid
  schoolId   String    @map("school_id") @db.Uuid
  classArmId String    @map("class_arm_id") @db.Uuid
  subjectId  String    @map("subject_id") @db.Uuid
  sessionId  String    @map("session_id") @db.Uuid
  termId     String    @map("term_id") @db.Uuid
  // Optional — defaults to "Exam" for display (confirmed; unlike
  // Evaluation, exams don't need a teacher-authored name/description).
  name       String?
  createdBy  String    @map("created_by") @db.Uuid
  deletedAt  DateTime? @map("deleted_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  school        School          @relation(fields: [schoolId], references: [id])
  classArm      ClassArm        @relation(fields: [classArmId], references: [id])
  subject       Subject         @relation(fields: [subjectId], references: [id])
  session       AcademicSession @relation(fields: [sessionId], references: [id])
  term          Term            @relation(fields: [termId], references: [id])
  createdByUser User            @relation("ExamCreatedBy", fields: [createdBy], references: [id])
  scores        ExamScore[]

  @@index([schoolId, classArmId, subjectId, termId])
  @@map("exams")
}

model ExamScore {
  id        String    @id @default(uuid(7)) @db.Uuid
  examId    String    @map("exam_id") @db.Uuid
  studentId String    @map("student_id") @db.Uuid
  rawScore  Decimal?  @map("raw_score") @db.Decimal(5, 2)
  isAbsent  Boolean   @default(false) @map("is_absent")
  enteredBy String?   @map("entered_by") @db.Uuid
  enteredAt DateTime? @map("entered_at")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")

  exam          Exam    @relation(fields: [examId], references: [id])
  student       Student @relation(fields: [studentId], references: [id])
  enteredByUser User?   @relation("ExamScoreEnteredBy", fields: [enteredBy], references: [id])

  @@unique([examId, studentId])
  @@map("exam_scores")
}

// Per student+subject+term exam average — analog of TermSubjectResult for
// Track B, own publish state (Q3/step-1 scope). No subjectPosition — Q6
// ranks only at the per-term (cross-subject) and whole-year levels.
model TermSubjectExamResult {
  id          String       @id @default(uuid(7)) @db.Uuid
  schoolId    String       @map("school_id") @db.Uuid
  studentId   String       @map("student_id") @db.Uuid
  subjectId   String       @map("subject_id") @db.Uuid
  sessionId   String       @map("session_id") @db.Uuid
  termId      String       @map("term_id") @db.Uuid
  classArmId  String       @map("class_arm_id") @db.Uuid
  totalScore  Decimal      @map("total_score") @db.Decimal(5, 2)
  autoGrade   String?      @map("auto_grade")
  status      ResultStatus @default(DRAFT)
  publishedAt DateTime?    @map("published_at")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  school   School          @relation(fields: [schoolId], references: [id])
  student  Student         @relation(fields: [studentId], references: [id])
  subject  Subject         @relation(fields: [subjectId], references: [id])
  session  AcademicSession @relation(fields: [sessionId], references: [id])
  term     Term            @relation(fields: [termId], references: [id])
  classArm ClassArm        @relation(fields: [classArmId], references: [id])

  @@unique([studentId, subjectId, termId, sessionId])
  @@index([schoolId, classArmId, subjectId, termId])
  @@map("term_subject_exam_results")
}

// Per student+term, cross-subject exam average — Q6 ranking (b), analog
// of TermOverallResult for Track B.
model TermExamResult {
  id            String       @id @default(uuid(7)) @db.Uuid
  schoolId      String       @map("school_id") @db.Uuid
  studentId     String       @map("student_id") @db.Uuid
  sessionId     String       @map("session_id") @db.Uuid
  termId        String       @map("term_id") @db.Uuid
  classArmId    String       @map("class_arm_id") @db.Uuid
  averageScore  Decimal      @map("average_score") @db.Decimal(5, 2)
  averageGrade  String?      @map("average_grade")
  examPosition  Int?         @map("exam_position")
  subjectsCount Int          @default(0) @map("subjects_count")
  status        ResultStatus @default(DRAFT)
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  school   School          @relation(fields: [schoolId], references: [id])
  student  Student         @relation(fields: [studentId], references: [id])
  session  AcademicSession @relation(fields: [sessionId], references: [id])
  term     Term            @relation(fields: [termId], references: [id])
  classArm ClassArm        @relation(fields: [classArmId], references: [id])

  @@unique([studentId, termId, sessionId])
  @@index([schoolId, classArmId, termId])
  @@map("term_exam_results")
}

// Per student+session, whole-year exam average across all terms so far —
// Q6 ranking (c). Purely derived/cached: recomputed whenever any
// TermExamResult for this student+session changes; no separate manual
// publish action of its own (confirmed) — a student's row is visible/
// ranked once at least one term this session is PUBLISHED, progressively,
// never waiting for all three terms to exist.
model YearExamResult {
  id               String       @id @default(uuid(7)) @db.Uuid
  schoolId         String       @map("school_id") @db.Uuid
  studentId        String       @map("student_id") @db.Uuid
  sessionId        String       @map("session_id") @db.Uuid
  averageScore     Decimal      @map("average_score") @db.Decimal(5, 2)
  averageGrade     String?      @map("average_grade")
  yearExamPosition Int?         @map("year_exam_position")
  termsCount       Int          @default(0) @map("terms_count")
  status           ResultStatus @default(DRAFT)
  createdAt        DateTime     @default(now()) @map("created_at")
  updatedAt        DateTime     @updatedAt @map("updated_at")

  school  School          @relation(fields: [schoolId], references: [id])
  student Student         @relation(fields: [studentId], references: [id])
  session AcademicSession @relation(fields: [sessionId], references: [id])

  @@unique([studentId, sessionId])
  @@index([schoolId, sessionId])
  @@map("year_exam_results")
}

// Score → grade mapping (SPEC_V0.3.md §1). Ranges must tile 0-100 with no
// gaps or overlaps across the school's active set — validated at the API
// layer on every mutation (PUT replaces the full set atomically), not by
// a DB constraint.
model GradeBoundary {
  id        String   @id @default(uuid(7)) @db.Uuid
  schoolId  String   @map("school_id") @db.Uuid
  grade     String
  minScore  Int      @map("min_score")
  maxScore  Int      @map("max_score")
  remark    String
  sortOrder Int      @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  school School @relation(fields: [schoolId], references: [id])

  @@unique([schoolId, grade])
  @@index([schoolId])
  @@map("grade_boundaries")
}

enum ResultStatus {
  DRAFT
  PENDING_APPROVAL
  PUBLISHED
}

// Cached per-student-per-subject-per-term computation (SPEC_V0.4.md §1) —
// so results/positions don't recompute on every read. v0.7 step 1: the
// SOURCE changed (average of this subject/term's Evaluation scores,
// exams excluded — SPEC_V0.7.md §2/§5), but this table's own columns and
// publish semantics are UNCHANGED from v0.4/v0.5 — recomputed on every
// affected EvaluationScore write, same status/position/publish contract
// the v0.6 portal wall already depends on.
model TermSubjectResult {
  id              String       @id @default(uuid(7)) @db.Uuid
  schoolId        String       @map("school_id") @db.Uuid
  studentId       String       @map("student_id") @db.Uuid
  subjectId       String       @map("subject_id") @db.Uuid
  sessionId       String       @map("session_id") @db.Uuid
  termId          String       @map("term_id") @db.Uuid
  classArmId      String       @map("class_arm_id") @db.Uuid
  // v0.7: simple mean of the student's decided (non-absent) Evaluation
  // scores for this subject/term, 0-100 native (no weighting/rescaling —
  // SPEC_V0.7.md Q1). 0 if nothing decided yet.
  totalScore      Decimal      @map("total_score") @db.Decimal(5, 2)
  // Nullable: no grade_boundaries band matches (shouldn't happen once a
  // school's boundaries tile 0-100, but not DB-enforced — see
  // GradeBoundary's own comment).
  autoGrade       String?      @map("auto_grade")
  overrideGrade   String?      @map("override_grade")
  finalGrade      String?      @map("final_grade")
  // Only set at publish time (step 3) — never leaked pre-publish.
  subjectPosition Int?         @map("subject_position")
  status          ResultStatus @default(DRAFT)
  publishedAt     DateTime?    @map("published_at")
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  school   School          @relation(fields: [schoolId], references: [id])
  student  Student         @relation(fields: [studentId], references: [id])
  subject  Subject         @relation(fields: [subjectId], references: [id])
  session  AcademicSession @relation(fields: [sessionId], references: [id])
  term     Term            @relation(fields: [termId], references: [id])
  classArm ClassArm        @relation(fields: [classArmId], references: [id])

  @@unique([studentId, subjectId, termId, sessionId])
  @@index([schoolId, classArmId, subjectId, termId])
  @@map("term_subject_results")
}

// Cached per-student-per-term computation across all their scored
// subjects (SPEC_V0.4.md §1). average_score is a SIMPLE (unweighted)
// mean of the student's term_subject_results.total_score — weighting by
// subject is explicitly deferred (SPEC_V0.4.md §6, "keep v0.4's rules
// simple"). Publishes when every one of the student's subject results
// for the term is published (step 3) — no separate published_at column
// here, unlike term_subject_results; see docs/DECISIONS.md.
model TermOverallResult {
  id              String       @id @default(uuid(7)) @db.Uuid
  schoolId        String       @map("school_id") @db.Uuid
  studentId       String       @map("student_id") @db.Uuid
  sessionId       String       @map("session_id") @db.Uuid
  termId          String       @map("term_id") @db.Uuid
  classArmId      String       @map("class_arm_id") @db.Uuid
  averageScore    Decimal      @map("average_score") @db.Decimal(5, 2)
  averageGrade    String?      @map("average_grade")
  overallPosition Int?         @map("overall_position")
  subjectsCount   Int          @default(0) @map("subjects_count")
  status          ResultStatus @default(DRAFT)
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")

  school   School          @relation(fields: [schoolId], references: [id])
  student  Student         @relation(fields: [studentId], references: [id])
  session  AcademicSession @relation(fields: [sessionId], references: [id])
  term     Term            @relation(fields: [termId], references: [id])
  classArm ClassArm        @relation(fields: [classArmId], references: [id])

  @@unique([studentId, termId, sessionId])
  @@index([schoolId, classArmId, termId])
  @@map("term_overall_results")
}

// SPEC_V0.5.md §2.3/Q3 — a principal-granted clearance to edit a CLOSED
// term's scores, scoped to one class arm + subject (not the whole term —
// minimizes blast radius). One row per unlock EPISODE, not a flag: created
// on unlock (relocked_at null = currently active), closed out on re-lock
// (relocked_at set). "Currently unlocked" is `WHERE relocked_at IS NULL`;
// at most one such row per (term, class arm, subject) is enforced by a
// hand-added partial unique index in the migration SQL (Prisma's DSL can't
// express partial indexes — same pattern as the is_current partial
// uniques elsewhere in this file). `reason` is required, not optional — a
// clearance action needs a stated reason for accountability.
model TermUnlock {
  id         String    @id @default(uuid(7)) @db.Uuid
  schoolId   String    @map("school_id") @db.Uuid
  termId     String    @map("term_id") @db.Uuid
  classArmId String    @map("class_arm_id") @db.Uuid
  subjectId  String    @map("subject_id") @db.Uuid
  reason     String
  unlockedBy String    @map("unlocked_by") @db.Uuid
  unlockedAt DateTime  @default(now()) @map("unlocked_at")
  relockedBy String?   @map("relocked_by") @db.Uuid
  relockedAt DateTime? @map("relocked_at")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")

  school         School   @relation(fields: [schoolId], references: [id])
  term           Term     @relation(fields: [termId], references: [id])
  classArm       ClassArm @relation(fields: [classArmId], references: [id])
  subject        Subject  @relation(fields: [subjectId], references: [id])
  unlockedByUser User     @relation("TermUnlockUnlockedBy", fields: [unlockedBy], references: [id])
  relockedByUser User?    @relation("TermUnlockRelockedBy", fields: [relockedBy], references: [id])

  @@index([schoolId, termId, classArmId, subjectId])
  @@map("term_unlocks")
}

// SPEC_V0.5.md §2.4/Q6 — two free-text remarks per student+term: the class
// teacher's remark and the principal's remark, each independently
// attributed (who wrote it, when). classArmId is denormalized, same
// reasoning as term_overall_results — a report-card run or a remarks-entry
// screen needs "every remark for this whole class arm's roster," not a
// per-student lookup re-deriving the arm from enrollment each time.
model TermRemark {
  id                String    @id @default(uuid(7)) @db.Uuid
  schoolId          String    @map("school_id") @db.Uuid
  studentId         String    @map("student_id") @db.Uuid
  sessionId         String    @map("session_id") @db.Uuid
  termId            String    @map("term_id") @db.Uuid
  classArmId        String    @map("class_arm_id") @db.Uuid
  teacherRemark     String?   @map("teacher_remark")
  teacherRemarkBy   String?   @map("teacher_remark_by") @db.Uuid
  teacherRemarkAt   DateTime? @map("teacher_remark_at")
  principalRemark   String?   @map("principal_remark")
  principalRemarkBy String?   @map("principal_remark_by") @db.Uuid
  principalRemarkAt DateTime? @map("principal_remark_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")

  school                School          @relation(fields: [schoolId], references: [id])
  student               Student         @relation(fields: [studentId], references: [id])
  session               AcademicSession @relation(fields: [sessionId], references: [id])
  term                  Term            @relation(fields: [termId], references: [id])
  classArm              ClassArm        @relation(fields: [classArmId], references: [id])
  teacherRemarkByUser   User?           @relation("TermRemarkTeacherBy", fields: [teacherRemarkBy], references: [id])
  principalRemarkByUser User?           @relation("TermRemarkPrincipalBy", fields: [principalRemarkBy], references: [id])

  @@unique([studentId, termId, sessionId])
  @@index([schoolId, classArmId, termId])
  @@map("term_remarks")
}
