{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "roots": ["<rootDir>/src", "<rootDir>/test"],
  "testEnvironment": "node",
  "testRegex": "\\.spec\\.ts$",
  "testPathIgnorePatterns": ["/node_modules/", "\\.e2e-spec\\.ts$"],
  "transform": {
    "^.+\\.(t|j)s$": "ts-jest"
  }
}
