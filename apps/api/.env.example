NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://scholametric:scholametric@localhost:5433/scholametric
REDIS_URL=redis://localhost:6380
CORS_ORIGIN=http://localhost:5173
# 32+ char random secrets, distinct per environment, e.g. `openssl rand -hex 48`
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
# Optional — file storage (v0.8.2). Leave all four blank to boot without
# Firebase; StorageService then throws only if something tries to use it.
# FIREBASE_PRIVATE_KEY: paste the service-account JSON's private_key as one
# line with literal \n sequences intact — the app unescapes them at runtime.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_STORAGE_BUCKET=
